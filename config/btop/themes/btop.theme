# Catppuccin Mocha Theme for btop

# Main background, leaves current background if empty
theme[main_bg]="#1e1e2e"

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#cdd6f4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f38ba8"

# Background color of selected item in lists
theme[selected_bg]="#313244"

# Foreground color of selected item in lists
theme[selected_fg]="#cba6f7"

# Color of inactive/disabled text
theme[inactive_fg]="#6c7086"

# Color of text appearing top on graphs
theme[graph_text]="#f5e0dc"

# Background color of the meter
theme[meter_bg]="#313244"

# Misc colors for processes box
theme[proc_misc]="#cba6f7"

# Box outline colors
theme[cpu_box]="#cba6f7"
theme[mem_box]="#a6e3a1"
theme[net_box]="#89dceb"
theme[proc_box]="#f9e2af"

# Box divider line color
theme[div_line]="#45475a"

# Temperature graph colors
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# CPU graph colors
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#f9e2af"
theme[cpu_end]="#f38ba8"

# Mem graph colors
theme[free]="#a6e3a1"
theme[cached]="#89dceb"
theme[available]="#f9e2af"
theme[used]="#f38ba8"

# Network graph colors
theme[download_start]="#89dceb"
theme[download_mid]="#cba6f7"
theme[download_end]="#f38ba8"

theme[upload_start]="#89dceb"
theme[upload_mid]="#cba6f7"
theme[upload_end]="#f38ba8"

# Process box color gradient
theme[process_start]="#a6e3a1"
theme[process_mid]="#f9e2af"
theme[process_end]="#f38ba8"
