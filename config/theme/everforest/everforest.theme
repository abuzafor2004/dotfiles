# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#2d353b"

# Main text color
theme[main_fg]="#d3c6aa"

# Title color for boxes
theme[title]="#9da9a0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7fbbb3"

# Background color of selected item in processes box
theme[selected_bg]="#3d484d"

# Foreground color of selected item in processes box
theme[selected_fg]="#e69875"

# Color of inactive/disabled text
theme[inactive_fg]="#859289"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#d3c6aa"

# Background color of the percentage meters
theme[meter_bg]="#343f44"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#d699b6"

# Cpu box outline color
theme[cpu_box]="#a7c080"

# Memory/disks box outline color
theme[mem_box]="#dbbc7f"

# Net up/down box outline color
theme[net_box]="#83c092"

# Processes box outline color
theme[proc_box]="#e67e80"

# Box divider line and small boxes line color
theme[div_line]="#475258"

# Temperature graph colors
theme[temp_start]="#a7c080"
theme[temp_mid]="#dbbc7f"
theme[temp_end]="#e67e80"

# CPU graph colors
theme[cpu_start]="#a7c080"
theme[cpu_mid]="#dbbc7f"
theme[cpu_end]="#e67e80"

# Mem/Disk free meter
theme[free_start]="#a7c080"
theme[free_mid]="#a7c080"
theme[free_end]="#a7c080"

# Mem/Disk cached meter
theme[cached_start]="#7fbbb3"
theme[cached_mid]="#7fbbb3"
theme[cached_end]="#7fbbb3"

# Mem/Disk available meter
theme[available_start]="#d699b6"
theme[available_mid]="#d699b6"
theme[available_end]="#d699b6"

# Mem/Disk used meter
theme[used_start]="#e67e80"
theme[used_mid]="#e67e80"
theme[used_end]="#e67e80"

# Download graph colors
theme[download_start]="#7fbbb3"
theme[download_mid]="#83c092"
theme[download_end]="#83c092"

# Upload graph colors
theme[upload_start]="#e67e80"
theme[upload_mid]="#e69875"
theme[upload_end]="#dbbc7f"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#7fbbb3"
theme[process_mid]="#83c092"
theme[process_end]="#83c092"
