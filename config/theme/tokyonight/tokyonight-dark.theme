# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1a1b26"

# Main text color
theme[main_fg]="#c0caf5"

# Title color for boxes
theme[title]="#a9b1d6"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7aa2f7"

# Background color of selected item in processes box
theme[selected_bg]="#292e42"

# Foreground color of selected item in processes box
theme[selected_fg]="#ff9e64"

# Color of inactive/disabled text
theme[inactive_fg]="#565f89"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c0caf5"

# Background color of the percentage meters
theme[meter_bg]="#24283b"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#bb9af7"

# Cpu box outline color
theme[cpu_box]="#7aa2f7"

# Memory/disks box outline color
theme[mem_box]="#9ece6a"

# Net up/down box outline color
theme[net_box]="#bb9af7"

# Processes box outline color
theme[proc_box]="#f7768e"

# Box divider line and small boxes line color
theme[div_line]="#414868"

# Temperature graph colors
theme[temp_start]="#9ece6a"
theme[temp_mid]="#e0af68"
theme[temp_end]="#f7768e"

# CPU graph colors
theme[cpu_start]="#9ece6a"
theme[cpu_mid]="#e0af68"
theme[cpu_end]="#f7768e"

# Mem/Disk free meter
theme[free_start]="#9ece6a"
theme[free_mid]="#9ece6a"
theme[free_end]="#9ece6a"

# Mem/Disk cached meter
theme[cached_start]="#7aa2f7"
theme[cached_mid]="#7aa2f7"
theme[cached_end]="#7aa2f7"

# Mem/Disk available meter
theme[available_start]="#bb9af7"
theme[available_mid]="#bb9af7"
theme[available_end]="#bb9af7"

# Mem/Disk used meter
theme[used_start]="#f7768e"
theme[used_mid]="#f7768e"
theme[used_end]="#f7768e"

# Download graph colors
theme[download_start]="#7aa2f7"
theme[download_mid]="#7dcfff"
theme[download_end]="#7dcfff"

# Upload graph colors
theme[upload_start]="#f7768e"
theme[upload_mid]="#ff9e64"
theme[upload_end]="#e0af68"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#7aa2f7"
theme[process_mid]="#7dcfff"
theme[process_end]="#7dcfff"
